{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diálogo — Home Switch",
  "type": "object",
  "required": ["id", "start", "nodes"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "titulo": { "type": "string" },
    "descricao": { "type": "string" },
    "start": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["speaker", "en", "pt"],
      "additionalProperties": true,
      "properties": {
        "speaker": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 },
        "end": { "type": "boolean" },
        "next": { "type": "string" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["en", "pt", "next"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "pt": { "type": "string", "minLength": 1 },
              "next": { "type": "string" }
            }
          }
        },
        "objective": {
          "type": "object",
          "required": ["device", "state"],
          "properties": {
            "device": { "type": "string" },
            "state": { "enum": ["on", "off", "eco"] }
          }
        },
        "vocab": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["en", "pt"],
            "properties": {
              "en": { "type": "string" },
              "pt": { "type": "string" }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["end"], "properties": { "end": { "const": true } } },
        { "required": ["next"] },
        { "required": ["choices"] },
        { "required": ["objective"] }
      ]
    }
  }
}
